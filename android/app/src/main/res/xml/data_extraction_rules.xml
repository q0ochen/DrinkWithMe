<?xml version="1.0" encoding="utf-8"?>
<!-- Ab Android 12: wie backup_rules.xml – die Anmeldung wird weder gesichert noch auf ein neues Gerät übertragen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="drinkwithme_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="drinkwithme_session.xml" />
    </device-transfer>
</data-extraction-rules>

# Vorlage für die lokale Entwicklung: als .env.local speichern (wird nicht eingecheckt).
# Alle Werte sind öffentlich (keine Geheimnisse) – siehe supabase/README.md, Abschnitt „Werte für die Apps“.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<Publishable/Anon-Key aus `supabase status`>
VITE_VAPID_PUBLIC_KEY=<öffentlicher VAPID-Schlüssel>
# Adresse der App; bestimmt auch die Vite-Basis. Mit http://127.0.0.1:5173 passt die Rückleitung
# http://127.0.0.1:5173/auth/callback zur lokalen supabase/config.toml.
VITE_WEB_APP_URL=http://127.0.0.1:5173

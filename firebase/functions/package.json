{
  "name": "drinkwithme-functions",
  "private": true,
  "description": "Cloud Functions (2nd gen) für die Trinkrunden von Drink With Me.",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.dev.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.mts",
    "test:emulator": "vitest run --config vitest.emulator.config.mts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "firebase": "12.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}

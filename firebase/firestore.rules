rules_version = '2';

// Sicherheitsregeln der Trinkrunden – Vertrag: docs/TRINKRUNDEN_ARCHITEKTUR.md
//
// Grundsatz: Alles ist verboten, was hier nicht ausdrücklich erlaubt ist.
// Runden und Einladungscodes schreiben ausschließlich die Cloud Functions (Admin SDK,
// umgeht diese Regeln). Clients dürfen nur ihr eigenes Profil, ihre eigenen
// Geräte-Tokens und eigene Getränke in Runden schreiben, in denen sie Mitglied sind.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hilfsfunktionen ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Text mit 1 bis maxLength Zeichen.
    function isText(value, maxLength) {
      return value is string && value.size() >= 1 && value.size() <= maxLength;
    }

    // Exakt diese Felder – keine fehlenden, keine zusätzlichen.
    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    // Mitgliedschaft wird am Runden-Dokument geprüft. Bewusst nur ein get() (kein zusätzliches
    // exists()): Jeder Aufruf zählt gegen das Limit von 20 Dokumentzugriffen pro Batch – so kann
    // die App ein Getränk in einem Batch mit bis zu 20 Runden teilen.
    function isMemberOf(groupId) {
      let group = get(groupPath(groupId));
      return isSignedIn() && group != null && request.auth.uid in group.data.memberIds;
    }

    // ---------- groups/{groupId}/drinks/{docId} ----------

    // Exakt die Felder aus dem Vertrag; Dokument-ID = "{authorId}_{drinkId}" – so kann kein anderes
    // Mitglied die ID eines fremden Getränks in einer Runde „besetzen“. Zeitstempel: consumedAt
    // höchstens 24 h alt bzw. 5 min in der Zukunft, createdAt = serverTimestamp().
    function isValidSharedDrink(docId) {
      let drink = request.resource.data;
      return hasExactly(drink, [
          'drinkId', 'authorId', 'authorName', 'name', 'category',
          'volumeInMilliliters', 'note', 'consumedAt', 'createdAt'
        ])
        && drink.drinkId is string
        && drink.drinkId.size() >= 1
        && drink.authorId == request.auth.uid
        && docId == request.auth.uid + '_' + drink.drinkId
        && isText(drink.authorName, 50)
        && isText(drink.name, 50)
        && drink.category in [
          'WATER', 'COFFEE', 'TEA', 'JUICE', 'SOFT_DRINK', 'BEER', 'WINE', 'COCKTAIL', 'OTHER'
        ]
        && drink.volumeInMilliliters is int
        && drink.volumeInMilliliters >= 1
        && drink.volumeInMilliliters <= 5000
        && (drink.note == null || (drink.note is string && drink.note.size() <= 280))
        && drink.consumedAt is timestamp
        && drink.consumedAt >= request.time - duration.value(24, 'h')
        && drink.consumedAt <= request.time + duration.value(5, 'm')
        && drink.createdAt == request.time;
    }

    // ---------- users/{uid} ----------

    // displayName: string (1–50), photoUrl: string | null (optional), updatedAt: serverTimestamp
    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'photoUrl', 'updatedAt'])
        && isText(data.displayName, 50)
        && (!('photoUrl' in data)
            || data.photoUrl == null
            || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.updatedAt == request.time;
    }

    // Dokument-ID = FCM-Token: nur Zeichen und Länge, die ein FCM-Token haben kann – gleichbedeutend mit
    // '^[A-Za-z0-9_:-]{20,1024}$' aus dem Vertrag. Die Länge wird getrennt geprüft, weil RE2 (die
    // Regex-Engine der Regeln) Wiederholungen nur bis 1000 erlaubt und {20,1024} nicht kompiliert.
    function isFcmToken(token) {
      return token.size() >= 20 && token.size() <= 1024 && token.matches('^[A-Za-z0-9_:-]+$');
    }

    // platform: "android", updatedAt: serverTimestamp
    function isValidDeviceToken(data) {
      return hasExactly(data, ['platform', 'updatedAt'])
        && data.platform == 'android'
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid) && isValidUserProfile(request.resource.data);
      allow delete: if isUser(uid);

      match /tokens/{token} {
        allow read: if isUser(uid);
        allow create, update: if isUser(uid) && isFcmToken(token) && isValidDeviceToken(request.resource.data);
        // Löschen ohne Formatprüfung, damit auch alte, ungültige Einträge entfernt werden können.
        allow delete: if isUser(uid);
      }
    }

    // ---------- groups/{groupId} ----------

    match /groups/{groupId} {
      // Funktioniert auch für die Abfrage where("memberIds", "array-contains", uid).
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Erstellen, Beitreten und Verlassen nur über die Cloud Functions.
      allow write: if false;

      // ---------- groups/{groupId}/drinks/{docId} ----------

      match /drinks/{docId} {
        allow read: if isMemberOf(groupId);
        allow create: if isMemberOf(groupId) && isValidSharedDrink(docId);
        // Geteilte Getränke sind unveränderlich.
        allow update: if false;
        // Der Autor darf löschen. Nicht vorhandene Dokumente dürfen „gelöscht“ werden,
        // damit die App ein Getränk per Batch aus allen Runden entfernen kann.
        allow delete: if isSignedIn()
          && (resource == null || resource.data.authorId == request.auth.uid);
      }
    }

    // ---------- inviteCodes/{code} und joinAttempts/{key} ----------

    // Nur für die Cloud Functions – kein Client-Zugriff.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Zähler gegen das Erraten von Codes – auch der eigene ist für Clients tabu.
    // key = SHA-256 (hex) von "google:" + Google-sub, ohne Google-Kennung die uid.
    match /joinAttempts/{key} {
      allow read, write: if false;
    }

    // ---------- Alles andere ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
